#VRML_SIM R2023b utf8

EXTERNPROTO "webots://projects/robots/franka_emika/panda/protos/Panda.proto"
EXTERNPROTO "webots://projects/robots/franka_emika/panda/protos/PandaHand.proto"
EXTERNPROTO "webots://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "webots://projects/objects/tables/protos/Table.proto"
EXTERNPROTO "webots://projects/objects/solids/protos/SolidBox.proto"
EXTERNPROTO "webots://projects/default/protos/DirectionalLight.proto"

WorldInfo {
  info [
    "Pose2Skill-Robot: High-Precision Franka Emika Panda Teleoperation",
    "Developed for Academic Graduation Project - Computer Vision & Robotics"
  ]
  title "Pose2Skill-Robot: Franka Panda Teleoperation"
  basicTimeStep 16
  FPS 60
}
Viewpoint {
  orientation -0.16 0.28 0.94 2.1
  position 1.45 -1.25 1.3
}
DirectionalLight {
  direction 0.5 0.5 -1
  intensity 1.3
  castShadows TRUE
}
DirectionalLight {
  direction -0.5 -0.5 1
  intensity 0.5
}
Floor {
  size 10 10
  tileSize 1 1
}
Table {
  translation 0.5 0 0
  size 1.2 0.9 0.75
}
Panda {
  translation 0.18 0 0.75
  rotation 0 0 1 0
  controller "panda_teleop"
  synchronization TRUE
  endEffector PandaHand {
  }
}
SolidBox {
  translation 0.55 0.05 0.78
  size 0.05 0.05 0.05
  mass 0.12
  appearance PBRAppearance {
    baseColor 0.85 0.15 0.15
    roughness 0.3
    metalness 0.1
  }
}
SolidBox {
  translation 0.55 -0.15 0.78
  size 0.04 0.04 0.04
  mass 0.1
  appearance PBRAppearance {
    baseColor 0.15 0.45 0.85
    roughness 0.3
    metalness 0.1
  }
}
